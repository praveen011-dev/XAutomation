# Copy to .env for local use. Never commit .env.

# Gemini text drafting
GEMINI_API_KEY=
# Optional model override. Example: gemini-3.5-flash-lite
# GEMINI_MODEL=

# X API OAuth 1.0a user credentials (needed to publish directly or verify account)
# The X developer App needs Read and write permission and API credits for posting.
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Research source: nitter (third-party public RSS mirrors) or api (official X API)
# XPOST_SCOOP_SOURCE=nitter
# NITTER_INSTANCES=host-one.example,host-two.example

# Local UI defaults to 127.0.0.1. For public hosting, set XPOST_UI_HOST=0.0.0.0
# and configure both secrets below. See DEPLOY.md.
XPOST_UI_PORT=4321
# XPOST_UI_HOST=0.0.0.0
# XPOST_UI_PASSWORD=use-a-unique-password-at-least-12-characters
# XPOST_UI_SECRET=generate-a-random-secret-with-at-least-32-characters
# XPOST_MANUAL=1 forces publishing through the composer for manual review.

# Optional storage path (Render needs a persistent disk for durable drafts).
# XPOST_DRAFTS_DIR=/var/data/drafts
# TWEET_REPOS=C:/code/project-a,C:/code/project-b
